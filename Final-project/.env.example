# Backend settings. Copy to .env and fill in. .env is ignored by git; never commit real secrets.

# Required
MONGO_URI=mongodb://localhost:27017/beepbite
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional
PORT=3000
JWT_EXPIRES_IN=1h

# Optional: creates the first admin at startup (once). Leave commented out if not needed; empty values are rejected.
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@beepbite.net
# ADMIN_PASSWORD=at-least-8-characters

# Optional: "Forgot password?" emails and the support form via Resend (https://resend.com). Without a key both are off.
# RESEND_API_KEY=re_...
# Sender, on the domain verified in Resend (default BeepBite <no-reply@beepbite.net>)
# RESEND_FROM=BeepBite <no-reply@beepbite.net>
# Where support page messages are delivered (default support@beepbite.net)
# SUPPORT_EMAIL=support@beepbite.net
# Where links in emails point (default http://localhost:4200; in production, the live site, e.g. https://beepbite.net)
# APP_URL=http://localhost:4200
